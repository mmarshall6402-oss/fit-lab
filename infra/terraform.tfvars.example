# Copy to terraform.tfvars (gitignored) and fill in real values.
# Never commit terraform.tfvars - it holds secrets.

# Generate with: openssl rand -hex 32
# Must ALSO be set as ORIGIN_VERIFY_SECRET on the Elastic Beanstalk
# environment (outside Terraform - see cloudfront.tf's comment on why EB
# itself isn't managed here) so the backend actually enforces it.
cloudfront_origin_verify_secret = "changeme-generate-a-real-random-secret"

alarm_email = "mmarshall1011@icloud.com"

# Optional - enables the CPU alarm. Find via:
#   aws elasticbeanstalk describe-environment-resources --environment-name Fitlab-backend-env
# eb_autoscaling_group_name = "awseb-e-xxxxxxxxxx-stack-AWSEBAutoScalingGroup-xxxxxxxxxxxxx"
