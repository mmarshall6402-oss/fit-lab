# Copy to terraform.tfvars (gitignored) and fill in with values from your
# existing Elastic Beanstalk environment / VPC. Nothing in this file is
# secret - the master password is generated by AWS and stored in Secrets
# Manager, never in a tfvars file or state.

aws_region = "us-east-1"

# EB console -> Fitlab-backend-env -> Configuration -> Instances -> VPC
vpc_id = "vpc-xxxxxxxx"

# Same page: subnets the EB instances run in (or the private subnets in the
# same VPC, if the EB instances are in public subnets). Need at least two,
# in different AZs.
subnet_ids = ["subnet-aaaaaaaa", "subnet-bbbbbbbb"]

# Same page: "EC2 security groups" - the one attached to the EB instances
# (not a load-balancer security group).
eb_security_group_id = "sg-xxxxxxxx"
